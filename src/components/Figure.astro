---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { isUrl, stripProtocol } from '../util/caption'
import { contentSizes, widthsFor } from '../util/images'

interface Props {
  src: ImageMetadata
  alt?: string
  caption?: string
}

const { src, alt = '', caption } = Astro.props
---

<figure>
  <Image src={src} alt={alt} widths={widthsFor(src)} sizes={contentSizes} class='mx-auto' />
  {caption && (
    <figcaption class='mt-1 text-sm text-right text-black/60'>
      {isUrl(caption) ? (
        <>
          Quelle:{' '}
          <a
            href={caption.trim()}
            target='_blank'
            rel='noopener noreferrer'
            class='underline hover:text-black'
          >
            {stripProtocol(caption)}
          </a>
        </>
      ) : (
        caption
      )}
    </figcaption>
  )}
</figure>
