{
	servers {
		# Requests arrive via the Coolify proxy, so take the visitor IP from X-Forwarded-For
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv
	file_server

	# Astro emits content-hashed files to /_astro, so they can be cached forever
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# These keep their URL when the file changes, so only cache them for a week
	@unhashed path /images/* /favicon.ico /favicon.svg /bb_favicon.png
	header @unhashed Cache-Control "public, max-age=604800"

	# Keep internal Uptime Kuma checks out of the access log (and GoAccess)
	@uptimekuma {
		client_ip private_ranges
		header User-Agent Uptime-Kuma*
	}
	log_skip @uptimekuma

	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				# Holds the unmasked visitor IP, client_ip already covers it
				request>headers>X-Forwarded-For delete
			}
		}
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
